# CodeSync AI Environment Configuration

# Frontend (client) - Configured in Vercel or client/.env
# Leave empty or set to http://localhost:5000 in local development
# Set to your deployed backend URL in Vercel Project Settings (e.g., https://codesync-backend.up.railway.app)
VITE_API_URL=http://localhost:5000
VITE_SERVER_URL=http://localhost:5000

# Backend (server) - Configured in your backend hosting service (Railway, Render, Fly.io, etc.)
PORT=5000
# Comma-separated allowed frontend origins for CORS and Socket.IO
# Include your Vercel production domain here (e.g., https://your-app.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173,http://localhost:5174
